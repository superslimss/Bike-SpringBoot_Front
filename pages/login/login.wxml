<view class="login-page">
  <view class="login-bg"></view>

  <view class="login-wrapper">
    <view class="login-header">
      <view class="login-title">校园共享单车系统</view>
      <view class="login-subtitle">欢迎登录校园导航小程序</view>
    </view>

    <view class="login-card">
      <view class="card-title">账号登录</view>

      <view class="input-group">
        <view class="input-label">用户名</view>
        <input
          class="input-box"
          placeholder="请输入用户名"
          placeholder-class="input-placeholder"
          value="{{username}}"
          bindinput="onUsernameInput"
        />
      </view>

      <view class="input-group">
        <view class="input-label">密码</view>
        <input
          class="input-box"
          placeholder="请输入密码"
          placeholder-class="input-placeholder"
          password="true"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>

      <button class="login-btn" bindtap="handleLogin">登 录</button>

      <view class="login-tip">
        普通用户和管理员均可使用账号密码登录
      </view>
    </view>
  </view>
</view>