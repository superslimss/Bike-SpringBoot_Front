<view class="login-page">
  <view class="login-bg"></view>
  <view class="login-wrapper">
    <view class="login-header">
      <view class="login-title">新用户注册</view>
      <view class="login-subtitle">加入校园共享单车系统</view>
    </view>

    <view class="login-card">
      <view class="input-group">
        <view class="input-label">账号</view>
        <input class="input-box" placeholder="设置用户名" bindinput="onUsernameInput" />
      </view>

      <view class="input-group">
        <view class="input-label">密码</view>
        <input class="input-box" password placeholder="设置登录密码" bindinput="onPasswordInput" />
      </view>

      <view class="input-group">
        <view class="input-label">手机号</view>
        <input class="input-box" type="number" placeholder="请输入手机号" bindinput="onPhoneInput" />
      </view>

      <button class="login-btn" bindtap="handleRegister">注 册</button>

      <view class="login-tip" bindtap="goBack">
        <text>已有账号？直接登录</text>
        <text class="register-link">返回</text>
      </view>
    </view>
  </view>
</view>