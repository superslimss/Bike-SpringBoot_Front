/* 基础容器：复用登录页渐变底色 */
.login-page {
  width: 100%;
  height: 100vh; /* 改为100vh确保撑满屏幕 */
  position: relative;
  background: linear-gradient(180deg, #dff3ff 0%, #eef7fb 45%, #f7f9fc 100%);
  box-sizing: border-box;
  overflow: hidden;
}

/* 装饰圆：复用登录页半透明圆球 */
.login-bg {
  position: absolute;
  top: -120rpx;
  left: -80rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: rgba(64, 158, 255, 0.12);
}

.login-wrapper {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 120rpx 40rpx 40rpx;
}

.login-header {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 40rpx;
}

.login-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #1f2d3d;
  line-height: 1.4;
}

.login-subtitle {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #6b7a90;
}

/* 白色卡片：复用圆角与阴影 */
.login-card {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 42rpx 34rpx 40rpx;
  box-shadow: 0 18rpx 40rpx rgba(31, 45, 61, 0.08);
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #253858;
  margin-bottom: 34rpx;
  text-align: center;
}

.input-group {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 26rpx;
}

.input-label {
  font-size: 26rpx;
  color: #4a5568;
  margin-bottom: 12rpx;
  padding-left: 6rpx;
}

/* 输入框：复用背景色与边框 */
.input-box {
  width: 100%;
  height: 92rpx;
  background: #f7f9fc;
  border: 2rpx solid #e7edf5;
  border-radius: 18rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1f2d3d;
  box-sizing: border-box;
}

.input-placeholder {
  color: #a0aec0;
  font-size: 28rpx;
}

/* 注册按钮：微调为绿色系以示区分，保留阴影与高度 */
.login-btn {
  margin-top: 24rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #42d392, #24b47e); /* 优雅的绿色渐变 */
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 12rpx 24rpx rgba(36, 180, 126, 0.22);
  box-sizing: border-box;
}

.login-btn::after {
  border: none;
}

/* 底部提示栏：左右布局 */
.login-tip {
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #999;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.register-link {
  color: #0062ff;
  font-size: 24rpx;
  font-weight: 500;
  padding-left: 10rpx;
}