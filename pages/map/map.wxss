/* pages/map/map.wxss */
.card {
  height: 90px;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f2f1ed;
}

.card-top {
  height: 80px;
  background-color: #ffffff;
  border-radius: 10px;
  display: flex;
  justify-content: space-between;
  box-shadow: 1px 1px 5px 2px rgba(0, 0, 0, 0.2);
  overflow: hidden; /* ✅ 防止高亮背景出格 */
}

.card-top-left {
  display: flex;
  flex-direction: column;
  border-radius: 10px 0 0 10px;
  min-width: 0; /* ✅ 允许文字省略 */
}

/* 每一行固定高度：40px（80px = 40 + 40） */
.card-top-left-view {
  height: 40px;
  margin-left: 10px;
  display: flex;
  align-items: center; /* ✅ 行内垂直居中 */
  min-width: 0;
}

.up {
  border-bottom: 1px solid #d8d8d8;
}

.card-top-circle {
  width: 15px;
  height: 15px;
  border-radius: 50%;
  margin-right: 10px;
}

.start { background-color: #8e1d21; }
.end { background-color: #404481; }

/* ✅ 顶部两行显示文本（代替原 input） */
.card-top-text {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  align-items: center;      /* ✅ 文字垂直居中 */
  white-space: nowrap;      /* ✅ 单行 */
  overflow: hidden;         /* ✅ 省略 */
  text-overflow: ellipsis;
  color: #333;
  font-size: 14px;
  transform: translateY(-10px);   /* ✅ 向上微调 1px */
}

/* ✅ 点击行区域（不改变高度） */
.nav-row {
  padding-right: 10px;
  border-radius: 8px;
}

/* ✅ 选点模式：高亮整行 */
.nav-active {
  background-color: #e6f2ff;
}

/* ✅ 选点模式：文字更明显 */
.nav-text-active {
  color: #0062ff;
  font-weight: 700;
}

.card-top-middle {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 10px 10px 0;
}

.card-top-middle-button {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-top-right {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 10px 10px 0;
  margin-right: 10px;
}

.card-top-right-button {
  background-color: #0062ff;
  color: white;
  width: 70px;
  height: 40px;
  border-radius: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 锁定页面根节点 */
page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.map-container {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  position: relative;
}

::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

.relative {
  position: relative;
  height: 40px;
  display: flex;
  justify-content: space-around;
}

.relative-mode {
  display: flex;
  justify-content: center;
  align-items: center;
}

.mode {
  width: 80px;
  background-color: #f0f0f099;
  border-radius: 20px;
  font-weight: bold;
  text-align: center;
  padding: 3px;
  border: 1px solid lightgray;
}

.card-bottom-category {
  height: 100%;
  text-align: center;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}

.card-bottom-category-label {
  width: 71px;
  height: 30px;
  margin-left: 2px;
  margin-right: 2px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.choose {
  background-color: #39a096;
  color: white;
  border-radius: 20px;
  font-weight: bold;
}

.map_right_card {
  height: 190px;
  position: absolute;
  right: 0px;
}

.location {
  width: 60px;
  height: 65px;
}

.location-btn {
  position: absolute;
  right: 30rpx;
  bottom: 100rpx;
  width: 90rpx;
  height: 90rpx;
  background-color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

.location-btn cover-image {
  width: 50rpx;
  height: 50rpx;
}

.instruction {
  height: 55px;
  width: 55px;
  background-color: #73a5d6;
  border-radius: 50%;
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
  margin-right: 5px;
}

.img {
  width: 55px;
  height: 55px;
  margin-right: 5px;
  margin-bottom: 10px;
}

.duration_and_distance {
  display: flex;
  justify-content: space-between;
}

.duration_and_distance_style {
  display: flex;
  align-items: flex-end;
  font-size: larger;
  font-weight: bold;
}

.duration_and_distance_text {
  background-color: white;
  padding: 8px;
}

.card-bottom {
  position: relative;
  width: 100%;
  height: 50px;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-bottom-button {
  padding: 5px;
  width: 94%;
  font-size: larger;
  color: #0152d6;
  background-color: #f3f3ff;
  border: 1px solid #0152d6;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.road {
  display: flex;
  text-align: left;
}

.r_duration_and_distance { margin-bottom: 15px; }
.road_start { margin-bottom: 10px; }
.road_end { margin-top: 10px; }

.picker {
  margin: 0 5px;
  padding: 2px 5px;
  background: #f8f8f8;
  border-radius: 8rpx;
  border: 1rpx solid #ddd;
  display: flex;
  justify-content: center;
  align-items: center;
}

.riding-panel {
  position: fixed;
  bottom: 50rpx;
  left: 30rpx;
  right: 30rpx;
  background: #fff;
  border-radius: 30rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 100;
}

.panel-header {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #07c160;
  border-radius: 50%;
  margin-right: 10rpx;
}

.time-num {
  font-size: 80rpx;
  font-weight: bold;
  color: #333;
  font-family: 'Courier New', Courier, monospace;
}

.time-label {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  display: block;
}

.btn-stop {
  margin-top: 30rpx;
  background: #333;
  color: #fff;
  width: 400rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
}

/* 右下角刷新按钮（在回到我的位置上方） */
.reset-btn {
  position: absolute;
  right: 30rpx;
  bottom: 220rpx; /* 比 location-btn 的 100rpx 高一些 */
  width: 90rpx;
  height: 90rpx;
  background-color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  z-index: 999;
}

.reset-btn cover-image {
  width: 50rpx;
  height: 50rpx;
}