<view class="card">
  <view class="card-top">
    <view class="card-top-left" style="width: calc(100vw - 130px)">

      <!-- 起点 -->
      <view class="card-top-left-view up nav-row {{pickMode === 'start' ? 'nav-active' : ''}}" data-type="start" bindtap="startPick">
        <view class="card-top-circle start"></view>
        <text class="card-top-text {{pickMode === 'start' ? 'nav-text-active' : ''}}">
          {{pickMode === 'start' ? '选点中：点击地图' : (start.name || '当前地点/起点')}}
        </text>
      </view>

      <!-- 终点 -->
      <view class="card-top-left-view nav-row {{pickMode === 'end' ? 'nav-active' : ''}}" data-type="end" bindtap="startPick">
        <view class="card-top-circle end"></view>
        <text class="card-top-text {{pickMode === 'end' ? 'nav-text-active' : ''}}">
          {{pickMode === 'end' ? '选点中：点击地图' : (end.name || '请选择终点')}}
        </text>
      </view>

    </view>

    <view class="card-top-middle">
      <image src="{{exchange}}" class="card-top-middle-button" bindtap="exchange" />
    </view>

    <view class="card-top-right">
      <view class="card-top-right-button" bindtap="formSubmit">路线</view>
    </view>
  </view>
</view>

<!-- 快捷地标分类栏 -->
<view class="relative">
  <scroll-view style="flex: 1; min-width: 0" scroll-x="true" scroll-with-animation="true">
    <view class="card-bottom-category" style="width: {{site_data.length*75}}px;">
      <view class="card-bottom-category-label {{index == category ? 'choose' : ''}}" wx:for="{{site_data}}" wx:key="id" id="{{index}}" bindtap="changeCategory">
        {{item.name}}
      </view>
    </view>
  </scroll-view>
</view>

<!-- 路线信息卡片 -->
<view wx:if="{{routeDistanceText}}" class="route-info-card">
  <view class="route-info-head">
    <view class="route-info-row">{{routeDistanceText}}</view>

    <view class="route-mode-tabs">
      <view class="tab {{travelMode==='walk' ? 'tab-on' : ''}}" data-mode="walk" bindtap="onModeTap">步行</view>
      <view class="tab {{travelMode==='bike' ? 'tab-on' : ''}}" data-mode="bike" bindtap="onModeTap">骑车</view>
    </view>
  </view>

  <view class="route-info-row">{{routeTimeText}}</view>
  <view wx:if="{{routeExtraText}}" class="route-info-extra">{{routeExtraText}}</view>
</view>

<map id="map" style="width: 100%; height: calc(100vh - 100px)" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" markers="{{markers}}" polyline="{{polyline}}" polygons="{{polygons}}" show-location="{{false}}" bindmarkertap="markertap" bindtap="onMapTap">
  <cover-view class="map_right_card" style="margin-top: calc(100vh - 375px)">
    <cover-view class="location" wx:if="{{polyline.length != 0}}" bindtap="restore">
      <cover-image class="img" src="{{restore}}" />
    </cover-view>
    <cover-view class="location" bindtap="location">
      <cover-image class="img" src="{{location}}" />
    </cover-view>
  </cover-view>

  <!-- 刷新/重置按钮 -->
  <cover-view class="reset-btn" bindtap="resetNavigation">
    <cover-image src="/images/refresh.png"></cover-image>
  </cover-view>

  <cover-view class="location-btn" bindtap="restore">
    <cover-image src="/images/center.png"></cover-image>
  </cover-view>
</map>
<!-- 正常骑行窗口 -->
<view class="riding-panel" wx:if="{{isRiding && !showOutParkingModal}}">
  <view class="panel-header">
    <text class="status-dot"></text>
    <text>正在骑行</text>
  </view>

  <view class="time-row">
    <view class="time-left">
      <text class="time-label">骑行时间</text>
      <text class="time-num">{{ridingTime}}</text>
    </view>

    <view class="time-right">
      <text class="time-label">费用</text>
      <view class="fee-wrap">
        <text class="fee-num">{{ridingFee}}</text>
        <text class="fee-unit">元</text>
      </view>
    </view>
  </view>

  <view class="btn-group">
    <button class="btn-main" bindtap="finishOrder">结束骑行</button>
  </view>
</view>

<!-- 违停窗口 -->
<view class="riding-panel" wx:if="{{isRiding && showOutParkingModal}}">
  <view class="panel-header">
    <text class="status-dot"></text>
    <text>当前不在停车点内</text>
  </view>

  <view class="time-row">
    <view class="time-left">
      <text class="time-label">骑行时间</text>
      <text class="time-num">{{ridingTime}}</text>
    </view>

    <view class="time-right">
      <text class="time-label">费用</text>
      <view class="fee-wrap">
        <text class="fee-num">{{outOfAreaFee}}</text>
        <text class="fee-unit">元</text>
      </view>
    </view>
  </view>

  <view class="btn-group-double">
    <button class="btn-sub" bindtap="cancelOutParking">取消还车</button>
    <button class="btn-danger" bindtap="confirmForceFinish">支付还车费并还车</button>
  </view>
</view>

<!-- 底部扫码用车按钮（非骑行状态才显示） -->
<view class="bottom-bar" wx:if="{{!isRiding}}">
  <view class="scan-btn {{isUnlockMode ? 'scan-btn-cancel' : ''}}" bindtap="toggleUnlockMode">
    {{isUnlockMode ? '取消扫码' : '扫码用车'}}
  </view>
</view>

<mp-dialog title="{{card.name || '详情'}}" show="{{dialogShow_site}}" bindbuttontap="mapmarker_choose" buttons="{{buttons}}">
  <view>
    <image wx:if="{{card.img}}" mode="heightFix" style="height: 270rpx" src="{{card.img}}"></image>
    <view>{{card.desc}}</view>
  </view>
</mp-dialog>