<!-- pages/history-detail/history-detail.wxml -->
<view class="detail-page">
  <!-- 1. 缩小地图高度 -->
  <map id="orderMap" class="map"
    latitude="{{centerLat}}" longitude="{{centerLng}}"
    markers="{{markers}}" polyline="{{polyline}}" scale="16">
  </map>

  <!-- 2. 详情卡片 -->
  <view class="detail-card">
    <!-- 顶部状态与金额对齐 -->
    <view class="header-section">
      <view class="status-left">
        <text class="status-title">行程已完成</text>
        <text class="ride-id">订单号: {{order.id}}</text>
      </view>
      <!-- 金额移至右侧 -->
      <view class="fee-right">
        <text class="symbol">￥</text>
        <text class="fee-amount">{{order.fee}}</text>
      </view>
    </view>

    <view class="divider"></view>

    <!-- 详细数据 -->
    <view class="detail-info">
      <view class="info-item">
        <view class="dot start"></view>
        <text class="label">开始时间</text>
        <text class="value">{{order.startTime}}</text>
      </view>
      <view class="info-item">
        <view class="dot end"></view>
        <text class="label">结束时间</text>
        <text class="value">{{order.endTime}}</text>
      </view>
      <view class="info-item">
        <view class="icon-clock"></view>
        <text class="label">骑行时长</text>
        <text class="value highlight">{{order.rideTime}}</text>
      </view>
    </view>
  </view>
</view>