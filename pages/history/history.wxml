<view class="history-container">
  <view class="history-card" wx:for="{{orders}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
    <view class="card-header">
      <text class="bike-no">车辆编号: {{item.bikeId}}</text>
      <view class="status-badge {{item.parkingAreaId != 0 ? 'status-success' : 'status-warning'}}">
      <view class="dot"></view>
      <text>{{item.parkingAreaId != 0 ? '正常还车' : '违规停放'}}</text>
    </view>
    </view>

    <view class="card-content">
      <view class="info-item">
        <text class="label">开始时间</text>
        <text class="value">{{item.startTime}}</text>
      </view>
      <view class="info-item">
        <text class="label">骑行时长</text>
        <text class="value">{{item.rideTime}}</text>
      </view>
      <view class="info-item">
        <text class="label">骑行费用</text>
        <text class="value price">￥{{item.fee || 0}}</text>
      </view>
    </view>

    <view class="card-footer">
      <text>查看骑行轨迹</text>
      <text class="arrow">></text>
    </view>
  </view>

  <view class="empty-state" wx:if="{{orders.length === 0}}" style="text-align:center; padding-top:100rpx; color:#999;">
    <text>暂无骑行记录</text>
  </view>
</view>