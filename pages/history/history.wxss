.history-container { padding: 20rpx; background: #f7f9fc; min-height: 100vh; }
.history-card { 
  background: #fff; border-radius: 24rpx; padding: 30rpx; margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.05);
}
.card-header { display: flex; justify-content: space-between; margin-bottom: 20rpx; align-items: center; }
.bike-no { font-weight: bold; color: #333; font-size: 30rpx; }
.status-tag { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 8rpx; }
.success { background: #e7f7ed; color: #07c160; }
.warning { background: #fff1f0; color: #ff4d4f; }

.info-item { display: flex; justify-content: space-between; margin-bottom: 12rpx; font-size: 26rpx; }
.label { color: #999; }
.value { color: #444; }
.price { color: #ff4d4f; font-weight: bold; }

.card-footer { 
  border-top: 1rpx solid #eee; margin-top: 20rpx; padding-top: 20rpx;
  display: flex; justify-content: space-between; font-size: 24rpx; color: #0062ff;
}

/* 状态标签基础样式 */
.status-badge {
  display: flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 100rpx; /* 圆角矩形 */
  font-size: 24rpx;
  font-weight: 500;
}

/* 状态前面的小圆点 */
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

/* 正常还车：清新绿 */
.status-success {
  background-color: #e7f7ed;
  color: #07c160;
}
.status-success .dot {
  background-color: #07c160;
}

/* 违规停放：警示红 */
.status-warning {
  background-color: #fff1f0;
  color: #ff4d4f;
}
.status-warning .dot {
  background-color: #ff4d4f;
  /* 可以加一个淡淡的闪烁效果 */
  box-shadow: 0 0 8rpx #ff4d4f;
}